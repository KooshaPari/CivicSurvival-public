# Public .gitignore for the Civic Survival client source snapshot.
# (Snapshot script renames this file to .gitignore in the public repo.)

# Build output
bin/
obj/
Library/
dist/

# AgilePlus local runtime state is generated evidence tooling output, not source.
.agileplus/*.db

# Node / UI
node_modules/

# Secrets — environment files are never committed (the .env.example template IS).
*.env
!.env.example
!*/.env.example

# Vendored binaries (e.g. Unity.Logging) are not redistributed in the public repo.
Libs/*.dll

# Debug symbols / source maps must never reach the public repo.
*.pdb
*.map

# Publish thumbnail (pulled from a separate assets repo at release time).
thumbnail.png

# IDE
.vs/
.idea/

# Python — caches from running pytest locally.
__pycache__/
.pytest_cache/
*.pyc
*.pyo

# Build output of the Roslyn analyzer project (separate from CivicSurvival.csproj).
# The .csproj IS tracked; the build artifacts under bin/ and obj/ are not.
# Without this, contributors running `dotnet build CivicSurvival.Analyzers` see
# untracked file noise.
CivicSurvival.Analyzers/bin/
CivicSurvival.Analyzers/obj/

# Top-level build evidence directory generated by the host's tooling at runtime.
# Tracked only when explicitly staged via build-evidence/committed paths.
build-evidence/*.log
build-evidence/*.tmp

# OS / editor swap files
*.swp
*.swo
.DS_Store
Thumbs.db
