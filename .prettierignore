# Prettier ignore for CivicSurvival-public
# Files prettier can't parse / shouldn't format are listed here.

# INI-style files (no parser in prettier)
.coveragerc

# TOML config files (no parser in prettier by default; ruff handles its own format)
ruff.toml

# Build artifacts and evidence
build-evidence/
_build_detail.log
civic-wp01-evidence-manifest.json

# Python bytecode caches
__pycache__/
*.pyc
*.pyo

# Coverage output
.coverage
htmlcov/
.pytest_cache/

# GitHub workflows use their own YAML formatter in CI (actionlint); prettier's YAML
# formatter would fight with the existing indentation style and break checks.
# Workflows are validated by .github/workflows/ci.yml's actionlint step instead.
.github/workflows/

# Node modules (transient; created by `bun add --no-save prettier`)
node_modules/
package.json
package-lock.json
bun.lock
bun.lockb
